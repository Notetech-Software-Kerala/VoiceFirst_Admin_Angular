{
  "name": "voicefirst-admin",
  "version": "1.2.0",
  "scripts": {
    "ng": "ng",
    "generate-version": "node scripts/generate-version.js",
    "start": "npm run generate-version && ng serve",
    "build": "npm run generate-version && ng build",
    "watch": "ng build --watch --configuration development",
